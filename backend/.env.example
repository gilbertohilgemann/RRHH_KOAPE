# Desarrollo local (valores por defecto)
SECRET_KEY=cambia-esta-clave-secreta-por-una-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Producción: descomentar/ajustar y poner valores reales.
# SECRET_KEY debe ser una cadena aleatoria larga (nunca reutilizar la de desarrollo) — obligatoria cuando DEBUG=False.
# DEBUG=False
# ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
# CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Con DEBUG=False, el sistema exige HTTPS por defecto (redirige todo pedido HTTP).
# Si todavía estás probando por IP pública sin certificado (antes de armar
# nginx + Let's Encrypt), descomentá esto para no quedar con redirects a un
# HTTPS que no existe todavía. Sacalo (o poné True) apenas tengas el certificado.
# SECURE_SSL_REDIRECT=False

# Base de datos: por defecto usa SQLite. Para usar PostgreSQL (ver panel
# "Migración de Base de Datos" en /admin/ o el comando
# `manage.py migrate_to_postgres`), descomentá y completá esto:
# DB_ENGINE=postgres
# DB_NAME=rrhh_db
# DB_USER=rrhh_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Dirección pública de la aplicación (para los enlaces del manual del admin), ej. https://rrhh.miempresa.com
# URL_APP=
# host:puerto por los que responde el admin (vacío = cualquiera, desarrollo), ej. 1.2.3.4:8004
# ADMIN_HOSTS=
